<%- include('partials/header') %>

<h1>Edit Task</h1>

<form action="/update/<%= index %>" method="POST">

    <input 
        type="text"
        name="title"
        value="<%= task.title %>"
        required
    >

    <br><br>

    <input
        type="text"
        name="subject"
        value="<%= task.subject %>"
        required
    >

    <br><br>

    <button type="submit">
        Update Task
    </button>

</form>

<%- include('partials/footer') %>